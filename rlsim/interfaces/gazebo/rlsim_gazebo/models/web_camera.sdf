<sdf version="1.6">
  <model name="rlsim_web_camera">
    <static>true</static>
    <plugin name="web_camera_pose" filename="librlsim_web_camera_pose.so"/>
    <link name="camera_link">
      <gravity>false</gravity>
      <sensor name="web_camera" type="camera">
        <always_on>false</always_on>
        <update_rate>30</update_rate>
        <camera name="web_camera">
          <horizontal_fov>1.0471975512</horizontal_fov>
          <image><width>960</width><height>540</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>500</far></clip>
        </camera>
        <plugin name="rlsim_web_camera_ros" filename="libgazebo_ros_camera.so">
          <robotNamespace>/rlsim_viewer</robotNamespace>
          <cameraName>view</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>world</frameName>
          <updateRate>0</updateRate>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
