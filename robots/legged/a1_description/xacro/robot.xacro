<?xml version="1.0"?>

<robot name="a1_description" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find a1_description)/urdf/a1_description.urdf"/>
    <xacro:include filename="$(find a1_description)/xacro/gazebo.xacro"/>
    <xacro:include filename="$(find realsense_ros_gazebo)/xacro/depthcam.xacro"/>
    

    <xacro:realsense_d435 sensor_name="d435" parent_link="base" rate="30">
        <!-- <origin rpy="0 0.5 0" xyz="0.29 0 0.07"/> -->
        <!-- <origin rpy="0 0.349 0" xyz="0.34 0.01 0.08"/> -->
        <!-- <origin rpy="0 0.349 0" xyz="0.343 0.0214 0.0832"/> -->
        <origin rpy="0 0.0 0" xyz="0.27 0.0 0.03"/>
    </xacro:realsense_d435>
</robot>
