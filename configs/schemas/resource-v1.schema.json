{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RL sim2sim version 1 resources and experiment",
  "description": "Robot profiles in configs/wheel and configs/legged own control, policies and experiments. Nested contracts also receive runtime semantic validation.",
  "oneOf": [
    {
      "$ref": "#/$defs/robot"
    },
    {
      "$ref": "#/$defs/policy"
    },
    {
      "$ref": "#/$defs/terrain"
    },
    {
      "$ref": "#/$defs/backend"
    },
    {
      "$ref": "#/$defs/control"
    },
    {
      "$ref": "#/$defs/experiment"
    },
    {
      "$ref": "#/$defs/robot_profile"
    },
    {
      "$ref": "#/$defs/simulation"
    },
    {
      "$ref": "#/$defs/task_template"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "vector": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "maxItems": 32
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "positiveVector": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 1,
      "maxItems": 32
    },
    "gainVector": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 1,
      "maxItems": 32
    },
    "startup": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/vector"
        },
        "kp": {
          "$ref": "#/$defs/gainVector"
        },
        "kd": {
          "$ref": "#/$defs/gainVector"
        },
        "torque_limits": {
          "$ref": "#/$defs/positiveVector"
        }
      },
      "required": [
        "position",
        "kp",
        "kd",
        "torque_limits"
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "kp": {
          "$ref": "#/$defs/gainVector"
        },
        "kd": {
          "$ref": "#/$defs/gainVector"
        },
        "prone": {
          "$ref": "#/$defs/vector"
        },
        "pre_stand_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stand_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sit_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "passive_damping": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "kp",
        "kd",
        "prone",
        "pre_stand_s",
        "stand_s",
        "sit_s",
        "passive_damping"
      ],
      "additionalProperties": false
    },
    "physics": {
      "type": "object",
      "properties": {
        "step_size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "real_time_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gravity": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "step_size",
        "real_time_factor",
        "gravity"
      ],
      "additionalProperties": false
    },
    "robot": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "robot"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "robot_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "package_path": {
          "type": "string",
          "minLength": 1
        },
        "urdf": {
          "type": "string",
          "minLength": 1
        },
        "xacro": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "controllers": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "model_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "groups": {
          "type": "object",
          "properties": {
            "wheels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "legs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "wheels",
            "legs"
          ],
          "additionalProperties": false
        },
        "excluded_plugins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "robot_name",
        "variant",
        "package",
        "package_path",
        "urdf",
        "xacro",
        "controllers",
        "namespace",
        "model_name",
        "joints",
        "groups",
        "excluded_plugins"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "policy"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "robots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "config": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "robots",
        "config"
      ],
      "additionalProperties": false
    },
    "terrain": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": 1
            },
            "kind": {
              "const": "terrain"
            },
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "generator": {
              "const": "flat"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "friction": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                }
              },
              "required": [
                "size",
                "friction"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schema_version",
            "kind",
            "id",
            "generator",
            "parameters"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": 1
            },
            "kind": {
              "const": "terrain"
            },
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "generator": {
              "const": "stairs"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "friction": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                },
                "steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "rise": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "tread": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "start_x": {
                  "type": "number"
                }
              },
              "required": [
                "size",
                "friction",
                "steps",
                "rise",
                "tread",
                "width",
                "start_x"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schema_version",
            "kind",
            "id",
            "generator",
            "parameters"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": 1
            },
            "kind": {
              "const": "terrain"
            },
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "generator": {
              "const": "ramp"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "friction": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                },
                "angle_deg": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 75
                },
                "run": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "start_x": {
                  "type": "number"
                },
                "thickness": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "size",
                "friction",
                "angle_deg",
                "run",
                "width",
                "start_x",
                "thickness"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schema_version",
            "kind",
            "id",
            "generator",
            "parameters"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": 1
            },
            "kind": {
              "const": "terrain"
            },
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "generator": {
              "const": "rough"
            },
            "parameters": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "friction": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                },
                "rows": {
                  "type": "integer",
                  "minimum": 1
                },
                "columns": {
                  "type": "integer",
                  "minimum": 1
                },
                "cell": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "start_x": {
                  "type": "number"
                }
              },
              "required": [
                "size",
                "friction",
                "rows",
                "columns",
                "cell",
                "max_height",
                "start_x"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schema_version",
            "kind",
            "id",
            "generator",
            "parameters"
          ],
          "additionalProperties": false
        }
      ]
    },
    "backend": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "backend"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "adapter": {
          "const": "gazebo_classic_ros1"
        },
        "physics": {
          "$ref": "#/$defs/physics"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "adapter",
        "physics"
      ],
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "control"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "timing": {
          "type": "object",
          "properties": {
            "control_dt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "decimation": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "control_dt",
            "decimation"
          ],
          "additionalProperties": false
        },
        "startup": {
          "$ref": "#/$defs/startup"
        },
        "transition": {
          "$ref": "#/$defs/transition"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "joints",
        "timing",
        "startup",
        "transition"
      ],
      "additionalProperties": false
    },
    "experiment": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "experiment"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "robot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "policy": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "control": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "terrain": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "seed": {
          "type": "integer"
        },
        "spawn": {
          "type": "object",
          "properties": {
            "position": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "rpy": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "position",
            "rpy"
          ],
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "gui": {
              "type": "boolean"
            },
            "paused": {
              "type": "boolean"
            },
            "duration_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "gui",
            "paused",
            "duration_s"
          ],
          "additionalProperties": false
        },
        "terrain_parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "control": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "timing": {
                  "type": "object",
                  "properties": {
                    "control_dt": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "decimation": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "additionalProperties": false
                },
                "startup": {
                  "type": "object",
                  "properties": {
                    "position": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 1,
                      "maxItems": 32
                    },
                    "kp": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0
                      },
                      "minItems": 1,
                      "maxItems": 32
                    },
                    "kd": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0
                      },
                      "minItems": 1,
                      "maxItems": 32
                    },
                    "torque_limits": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "minItems": 1,
                      "maxItems": 32
                    }
                  },
                  "additionalProperties": false
                },
                "transition": {
                  "type": "object",
                  "properties": {
                    "kp": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0
                      },
                      "minItems": 1,
                      "maxItems": 32
                    },
                    "kd": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0
                      },
                      "minItems": 1,
                      "maxItems": 32
                    },
                    "prone": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 1,
                      "maxItems": 32
                    },
                    "pre_stand_s": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "stand_s": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "sit_s": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "passive_damping": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "backend": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "physics": {
                  "type": "object",
                  "properties": {
                    "step_size": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "real_time_factor": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "gravity": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "world": {
          "type": "string",
          "pattern": "\\.world$",
          "description": "Workspace world file; uses its terrain and physics directly."
        },
        "model_file": {
          "type": "string",
          "pattern": "^policies/.+\\.onnx$"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "robot",
        "policy",
        "control",
        "backend",
        "spawn",
        "runtime"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "world"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "terrain"
                ]
              },
              {
                "required": [
                  "seed"
                ]
              },
              {
                "required": [
                  "terrain_parameters"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "terrain",
            "seed",
            "terrain_parameters"
          ],
          "not": {
            "required": [
              "world"
            ]
          }
        }
      ]
    },
    "robot_profile": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "robot_profile"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "robot": {
          "type": "object",
          "properties": {
            "robot_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "variant": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "package_path": {
              "type": "string",
              "minLength": 1
            },
            "urdf": {
              "type": "string",
              "minLength": 1
            },
            "xacro": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "controllers": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "model_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "joints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true
            },
            "groups": {
              "type": "object",
              "properties": {
                "wheels": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "legs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "wheels",
                "legs"
              ],
              "additionalProperties": false
            },
            "excluded_plugins": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "robot_name",
            "variant",
            "package",
            "package_path",
            "urdf",
            "xacro",
            "controllers",
            "namespace",
            "model_name",
            "joints",
            "groups",
            "excluded_plugins"
          ],
          "additionalProperties": false
        },
        "control": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/$defs/identifier"
                },
                "timing": {
                  "type": "object",
                  "properties": {
                    "control_dt": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "decimation": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "control_dt",
                    "decimation"
                  ],
                  "additionalProperties": false
                },
                "startup": {
                  "$ref": "#/$defs/startup"
                },
                "transition": {
                  "$ref": "#/$defs/transition"
                }
              },
              "required": [
                "id",
                "timing",
                "startup",
                "transition"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
