{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated robot runtime v1",
  "description": "Generated by experiment prepare. Joint/controller names use robot order; mapping is policy index -> robot index; startup, transition and wheel_indices use policy order. The C++ loader additionally checks widths, permutations, finite numbers and robot name.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "robot_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "dt": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "decimation": {
      "type": "integer",
      "minimum": 1
    },
    "joint_names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "controller_names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "joint_mapping": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 31
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "wheel_indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 31
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "startup": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/vector"
        },
        "kp": {
          "$ref": "#/$defs/gainVector"
        },
        "kd": {
          "$ref": "#/$defs/gainVector"
        },
        "torque_limits": {
          "$ref": "#/$defs/positiveVector"
        }
      },
      "required": [
        "position",
        "kp",
        "kd",
        "torque_limits"
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "kp": {
          "$ref": "#/$defs/gainVector"
        },
        "kd": {
          "$ref": "#/$defs/gainVector"
        },
        "prone": {
          "$ref": "#/$defs/vector"
        },
        "pre_stand_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stand_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sit_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "passive_damping": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "kp",
        "kd",
        "prone",
        "pre_stand_s",
        "stand_s",
        "sit_s",
        "passive_damping"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "robot_name",
    "dt",
    "decimation",
    "joint_names",
    "controller_names",
    "joint_mapping",
    "wheel_indices",
    "startup",
    "transition"
  ],
  "additionalProperties": false,
  "$defs": {
    "vector": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "maxItems": 32
    },
    "gainVector": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 1,
      "maxItems": 32
    },
    "positiveVector": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 1,
      "maxItems": 32
    }
  }
}
