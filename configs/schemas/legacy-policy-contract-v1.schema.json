{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rlsim2sim:legacy-policy-contract:1",
  "title": "Resolved legacy policy inspection contract (not a runtime configuration)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "profile", "runner", "policy_type", "model", "timing", "robot", "observation", "action", "parameters", "base_parameters", "sources", "bindings", "reset"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "legacy_policy_contract"},
    "profile": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "runner": {"enum": ["rl_sim", "rl_wheel", "rl_amp"]},
    "policy_type": {"enum": ["dreamwaq", "ts", "ts_se"]},
    "model": {"type": "string", "minLength": 1},
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["control_dt", "decimation", "policy_dt", "scheduler"],
      "properties": {
        "control_dt": {"type": "number", "exclusiveMinimum": 0},
        "decimation": {"type": "integer", "minimum": 1},
        "policy_dt": {"type": "number", "exclusiveMinimum": 0},
        "scheduler": {"const": "independent_wall_clock_threads"}
      }
    },
    "robot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "dofs", "joint_names", "controller_names", "joint_mapping", "wheel_indices", "joint_indices"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "dofs": {"type": "integer", "minimum": 1},
        "joint_names": {"$ref": "#/$defs/names"},
        "controller_names": {"$ref": "#/$defs/names"},
        "joint_mapping": {"$ref": "#/$defs/indices"},
        "wheel_indices": {"$ref": "#/$defs/indices"},
        "joint_indices": {"$ref": "#/$defs/indices"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["terms", "width", "declared_width", "model_input_width", "quaternion_order", "ang_vel_source_frame", "history", "clip", "previous_action_stage"],
      "properties": {
        "terms": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "width"],
            "properties": {"name": {"type": "string"}, "width": {"type": "integer", "minimum": 1}}
          }
        },
        "width": {"type": "integer", "minimum": 1},
        "declared_width": {"type": "integer", "minimum": 1},
        "model_input_width": {"type": "integer", "minimum": 1},
        "quaternion_order": {"const": "wxyz"},
        "ang_vel_source_frame": {"const": "world"},
        "clip": {"type": "number", "exclusiveMinimum": 0},
        "previous_action_stage": {"const": "clipped_model_output"},
        "history": {
          "type": "object", "additionalProperties": false,
          "required": ["offsets", "layout", "includes_current", "initialization", "sampling"],
          "properties": {
            "offsets": {"type": "array", "items": {"type": "integer", "minimum": 0}},
            "layout": {"enum": ["time_major", "term_major"]},
            "includes_current": {"type": "boolean"},
            "initialization": {"enum": ["zeros", "uninitialized_legacy_heap"]},
            "sampling": {"const": "policy_tick"}
          }
        }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["joint_mode", "wheel_mode", "clip_lower", "clip_upper"],
      "properties": {
        "joint_mode": {"const": "position_offset"},
        "wheel_mode": {"const": "velocity"},
        "clip_lower": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/numbers"}]},
        "clip_upper": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/numbers"}]}
      }
    },
    "parameters": {"type": "object", "additionalProperties": {"anyOf": [{"type": "number"}, {"$ref": "#/$defs/numbers"}]}},
    "base_parameters": {"type": "object", "description": "Unmodified source values, retained to reveal policy overrides."},
    "sources": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
    "bindings": {"type": ["object", "null"], "description": "Null until actual model I/O has been inspected."},
    "reset": {
      "type": "object", "additionalProperties": false,
      "required": ["world_reset", "policy_entry"],
      "properties": {
        "world_reset": {"const": "not_coordinated_with_policy_state"},
        "policy_entry": {"const": "reinitializes_model_and_buffers"}
      }
    }
  },
  "$defs": {
    "names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "indices": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "numbers": {"type": "array", "items": {"type": "number"}}
  }
}
